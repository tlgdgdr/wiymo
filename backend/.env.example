# Copy to .env (or export in your shell) for non-default values.
# Defaults in application.yml already work with docker-compose Postgres.

DB_URL=jdbc:postgresql://localhost:5432/socialworld
DB_USERNAME=socialworld
DB_PASSWORD=socialworld

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

SERVER_PORT=8080
